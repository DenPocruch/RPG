MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: Cook_Dialogue
  m_EditorClassIdentifier: 
  npcName: "\u041F\u043E\u0432\u0430\u0440 \u0413\u0443\u0441\u0442\u0430\u0432"
  portrait: {fileID: -9180426125723624345, guid: cc3c14b22a4448341b6d32565360eef8, type: 3}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u041E-\u043E-\u043E! \u041D\u043E\u0432\u044B\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u043A!
      \u041C\u043E\u043D \u0430\u043C\u0438, \u0442\u044B \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u2014 \u0443 \u043C\u0435\u043D\u044F \u043A\u0430\u043A \u0440\u0430\u0437
      \u043B\u0443\u043A \u043F\u043B\u0430\u0447\u0435\u0442! \u0427\u0435\u0433\u043E
      \u0445\u043E\u0442\u0435\u043B?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u044C \u043C\u043D\u0435
        \u0435\u0434\u0443"
      nextNodeId: 1
      action: 1
      actionParam: 
      conditionTag: 
    - text: "\u0422\u044B \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
        \u043C\u043E\u044E \u0435\u0434\u0443?"
      nextNodeId: 2
      action: 2
      actionParam: 
      conditionTag: food_ready
    - text: "\u0422\u044B \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439, \u0413\u0443\u0441\u0442\u0430\u0432?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041D\u0438\u0447\u0435\u0433\u043E, \u043F\u043E\u043A\u0430"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 1
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041D\u0435\u0441\u0438 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B,
      \u0438 \u044F \u0432\u0441\u0451 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044E."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \u0442\u044B \u0441\u0430\u043C \u043E\u0442\u043A\u0443\u0434\u0430?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
  - id: 2
    text: "\u0414\u0430, \u0432\u0441\u0451 \u0433\u043E\u0442\u043E\u0432\u043E!
      \u0417\u0430\u0431\u0438\u0440\u0430\u0439."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u042F? \u0425\u0430! \u0412 \u0442\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
      \u044F \u0431\u0430\u0440\u0430\u043D\u043A\u0443 \u043A\u0440\u0443\u0442\u0438\u043B
      \u2014 \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439, \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0438,
      \u0441\u043E\u0441\u0438\u0441\u043A\u0438 \u0432 \u0442\u0435\u0441\u0442\u0435...
      \u0416\u0435\u043B\u0443\u0434\u043E\u043A \u0443\u0433\u0440\u043E\u0431\u0438\u043B,
      \u0441\u0435\u0440\u0434\u0446\u0435 \u0443\u0433\u0440\u043E\u0431\u0438\u043B.
      \u0410 \u0437\u0434\u0435\u0441\u044C... \u0437\u0434\u0435\u0441\u044C \u044F
      \u0443\u0447\u0443\u0441\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435!
      \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \xAB\u0441\u0443\u043F \u043A\u0430\u043A \u0443 \u043C\u0430\u043C\u044B\xBB
        \u2014 \u043F\u0440\u0430\u0432\u0434\u0430?"
      nextNodeId: 11
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0412\u043A\u0443\u0441\u043D\u043E \u043F\u0430\u0445\u043D\u0435\u0442.
        \u041F\u043E\u0439\u0434\u0443."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 11
    text: "\u041F\u0440\u0430\u0432\u0434\u0430! \u041C\u0430\u043C\u0430\u043D \u0434\u0435\u043B\u0430\u043B\u0430
      \u043B\u0443\u043A\u043E\u0432\u044B\u0439, \u043A\u043E\u0433\u0434\u0430
      \u044F \u0431\u043E\u043B\u0435\u043B... \u042F \u0432\u043A\u0443\u0441 \u0437\u0430\u0431\u044B\u043B,
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C? \u0417\u0430\u0431\u044B\u043B!
      \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435
      \u043E\u0432\u043E\u0449\u0438 \u2014 \u0441\u0435\u0440\u0435\u0431\u0440\u043E,
      \u0437\u043E\u043B\u043E\u0442\u043E \u2014 \u044F \u0432\u0441\u043F\u043E\u043C\u043D\u044E.
      \u0418 \u0442\u0435\u0431\u044F \u043D\u0430\u043A\u043E\u0440\u043C\u043B\u044E
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043D\u0435\u0439\u0440\u043E\u043D\u044B
      \u0437\u0430\u043F\u043E\u044E\u0442!"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u0440\u0438\u043D\u0435\u0441\u0443. \u041E\u0431\u0435\u0449\u0430\u044E."
      nextNodeId: 0
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
