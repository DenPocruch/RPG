  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: Blacksmith_Dialogue
  m_EditorClassIdentifier: 
  npcName: "\u041A\u0443\u0437\u043D\u0435\u0446 \u0421\u0442\u0435\u043F\u0430\u043D"
  portrait: {fileID: 5222287603771765860, guid: 0e8c1ce1a7761ce4192916dde24467ed, type: 3}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u0427\u0435\u0433\u043E \u0442\u0435\u0431\u0435, \u043F\u0443\u0442\u043D\u0438\u043A?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0412\u044B\u043A\u0443\u0439 \u043C\u043D\u0435 \u0432\u0435\u0449\u044C"
      nextNodeId: 1
      action: 3
      actionParam: 
      conditionTag: 
    - text: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0439
        \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0439?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041D\u0438\u0447\u0435\u0433\u043E"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 1
    text: "\u041F\u043E\u0448\u043B\u0438 \u043A \u0441\u0442\u0430\u043D\u043A\u0443.
      \u0422\u0430\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0418\u0434\u0443."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u0420\u0443\u043A\u0438... \u0431\u043E\u043B\u044F\u0442. \u0420\u0430\u043D\u044C\u0448\u0435
      \u043B\u044E\u0434\u0435\u0439 \u0447\u0438\u043D\u0438\u043B. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445.
      \u0410 \u0442\u0435\u043F\u0435\u0440\u044C... \u043C\u043E\u043B\u043E\u0442.
      \u0416\u0435\u043B\u0435\u0437\u043E \u043D\u0435 \u043F\u043B\u0430\u0447\u0435\u0442."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0422\u044B \u0431\u044B\u043B \u0432\u0440\u0430\u0447\u043E\u043C?"
      nextNodeId: 11
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041D\u0435 \u0431\u0443\u0434\u0443 \u043B\u0435\u0437\u0442\u044C."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 11
    text: "\u0425\u0438\u0440\u0443\u0440\u0433\u043E\u043C. \u0414\u0435\u0442\u0441\u043A\u0438\u043C.
      \u0422\u0440\u0435\u043C\u043E\u0440 \u043F\u043E\u0441\u043B\u0435 \u0430\u0432\u0430\u0440\u0438\u0438...
      \u0417\u0434\u0435\u0441\u044C \u043A\u0443\u044E, \u0447\u0442\u043E\u0431\u044B
      \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
      \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C \u043E\u0431\u0441\u0438\u0434\u0438\u0430\u043D
      \u0441 \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u2014 \u0432\u044B\u043A\u0443\u044E
      \u0442\u0435\u0431\u0435 \u043C\u0435\u0447. \u0418... \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0447\u0442\u043E \u0441\u043F\u0440\u043E\u0441\u0438\u043B."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u0440\u0438\u043D\u0435\u0441\u0443 \u043E\u0431\u0441\u0438\u0434\u0438\u0430\u043D."
      nextNodeId: 0
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0414\u0435\u0440\u0436\u0438\u0441\u044C, \u0421\u0442\u0435\u043F\u0430\u043D."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
