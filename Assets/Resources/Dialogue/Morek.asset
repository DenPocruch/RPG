  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: Morek
  m_EditorClassIdentifier: 
  npcName: "\u041C\u043E\u0440\u0435\u043A"
  portrait: {fileID: 0}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u0419\u043E-\u0445\u043E! \u0417\u0430\u0445\u043E\u0434\u0438, \u0440\u044B\u0431\u0430\u043A.
      \u041C\u043E\u0440\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0449\u0435\u0434\u0440\u043E\u0435
      \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0441\u0430\u043C. \u0427\u0435\u0433\u043E
      \u043D\u0430\u0434\u043E?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0412\u0437\u044F\u0442\u044C \u0443\u0434\u043E\u0447\u043A\u0443"
      nextNodeId: -1
      action: 7
      actionParam: GiveRod
      conditionTag: morek_norod
    - text: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0440\u044B\u0431\u0443
        (+50%)"
      nextNodeId: -1
      action: 7
      actionParam: SellFish
      conditionTag: 
    - text: "\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F"
      nextNodeId: -1
      action: 7
      actionParam: Collection
      conditionTag: 
    - text: "\u0422\u044B \u0434\u0430\u0432\u043D\u043E \u043D\u0430 \u043F\u043B\u044F\u0436\u0435,
        \u0434\u0435\u0434?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041F\u043E\u043A\u0430!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442,
      \u0441\u0430\u043B\u0430\u0433\u0430. \u0414\u043E\u043B\u0433-\u0442\u043E
      \u044F \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u043B...
      \u0410 \u043A\u0443\u0434\u0430 \u043C\u043D\u0435? \u0416\u0435\u043D\u0430
      \u0443\u043C\u0435\u0440\u043B\u0430, \u0434\u0435\u0442\u0438 \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435. \u0410 \u0437\u0434\u0435\u0441\u044C
      \u2014 \u043C\u043E\u0440\u0435, \u0442\u0440\u0443\u0431\u043A\u0430 \u0438
      \u0442\u044B. \u041C\u043E\u0440\u0435\u0447\u043A\u043E, \u043E\u043D\u043E
      \u0432\u0441\u0451 \u043F\u043E\u043C\u043D\u0438\u0442..."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F \u0440\u044B\u0431
        \u2014 \u044D\u0442\u043E \u0447\u0442\u043E?"
      nextNodeId: 11
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0411\u0430\u0439\u043A\u0443 \u0442\u0440\u0430\u0432\u0438!"
      nextNodeId: 12
      action: 0
      actionParam: 
      conditionTag: 
  - id: 11
    text: "\u0414\u043D\u0435\u0432\u043D\u0438\u043A \u043C\u043E\u0439. 43 \u0440\u044B\u0431\u043A\u0438
      \u2014 43 \u0433\u043E\u0434\u0430... \u041A\u0430\u0436\u0434\u0443\u044E
      \u043F\u043E\u043C\u043D\u044E, \u0433\u0434\u0435 \u0432\u0437\u044F\u043B.
      \u0421\u043E\u0431\u0435\u0440\u0451\u0448\u044C \u0432\u0441\u0435\u0445 \u2014
      \u043F\u043E\u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F \u043E\u0431
      \u043E\u0434\u043D\u043E\u043C. \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E. \u0418... \u0443\u0439\u0442\u0438
      \u043C\u043D\u0435 \u043D\u0430\u0434\u043E \u0431\u0443\u0434\u0435\u0442.
      \u0410 \u043B\u043E\u0434\u043A\u0443 \u0442\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044E."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0421\u043E\u0431\u0435\u0440\u0443. \u041E\u0431\u0435\u0449\u0430\u044E."
      nextNodeId: 0
      action: 0
      actionParam: 
      conditionTag: 
  - id: 12
    text: "\u0412\u043E-\u043E-\u043E\u0442 \u0442\u0430\u043A\u0443\u044E \u0449\u0443\u043A\u0443
      \u0432\u0438\u0434\u0430\u043B! \u0421 \u0434\u043E\u043C! \u041D\u0435 \u0432\u0435\u0440\u0438\u0448\u044C?
      \u0410 \u0437\u0440\u044F! \u041E\u043D\u0430 \u043C\u043D\u0435 \u043F\u043E\u0434\u043C\u0438\u0433\u043D\u0443\u043B\u0430
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \xAB\u041C\u043E\u0440\u0435\u043A,
      \u0442\u044B \u043E\u043F\u044F\u0442\u044C \u0432\u0440\u0451\u0448\u044C!\xBB
      \u0425\u0430-\u0445\u0430-\u0445\u0430! \u041B\u0430\u0434\u043D\u043E, \u0438\u0434\u0438
      \u0440\u044B\u0431\u0430\u0447\u044C, \u0441\u0430\u043B\u0430\u0433\u0430!"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0425\u0430! \u041F\u043E\u0439\u0434\u0443."
      nextNodeId: 0
      action: 0
      actionParam: 
      conditionTag: 
