  npcName: "\u041C\u044D\u0440 \u0410\u0432\u0440\u0435\u043B\u0438\u0439"
  portrait: {fileID: 0}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u043F\u0430\u0446\u0438\u0435\u043D\u0442! \u042F \u0432\u0435\u0440\u0438\u043B
      \u2014 \u0441 \u044D\u0442\u0438\u043C \u043F\u0443\u0441\u0442\u044F\u043A\u043E\u043C
      \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.
      \u0423\u0447\u0430\u0441\u0442\u043E\u043A \u0447\u0438\u0441\u0442, \u0441\u043B\u0438\u0437\u043D\u0438
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C. \u0414\u0435\u0440\u0436\u0438
      \u043D\u0430\u0431\u043E\u0440 \u043D\u043E\u0432\u043E\u0441\u0451\u043B\u0430:
      \u043C\u043E\u0442\u044B\u0433\u0430, \u0441\u0435\u0440\u043F, \u043B\u0435\u0439\u043A\u0430
      \u0438 \u0441\u0435\u043C\u0435\u043D\u0430 \u043F\u0448\u0435\u043D\u0438\u0446\u044B."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0430\u0431\u043E\u0440"
      nextNodeId: -1
