  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: Mayor_Dialogue
  m_EditorClassIdentifier: 
  npcName: "\u041C\u044D\u0440 \u0410\u0432\u0440\u0435\u043B\u0438\u0439"
  portrait: {fileID: 0}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u0422\u0430\u043A-\u0441... \u041F\u0430\u0446\u0438\u0435\u043D\u0442
      217... \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u044B... \u0430\u0433\u0430.
      \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E! \u0412\u044B
      \u0436\u0438\u0432\u044B. \u0423\u0441\u043B\u043E\u0432\u043D\u043E. \u042F
      \u2014 \u043C\u044D\u0440 \u0410\u0432\u0440\u0435\u043B\u0438\u0439. \u0414\u043E\u043B\u0433
      \u0432\u0430\u0448 \u2014 500 000 \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432.
      \u041E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435 \u2014 \u043F\u0440\u043E\u0441\u043D\u0451\u0442\u0435\u0441\u044C.
      \u0412\u043E\u043F\u0440\u043E\u0441\u044B?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0413\u0434\u0435 \u044F? \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430
        \u043C\u0435\u0441\u0442\u043E?"
      nextNodeId: 1
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041A\u0430\u043A \u043C\u043D\u0435 \u0432\u044B\u0439\u0442\u0438
        \u043E\u0442\u0441\u044E\u0434\u0430?"
      nextNodeId: 2
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E
        \u0441\u0435\u0439\u0447\u0430\u0441?"
      nextNodeId: 3
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0414\u0430\u0439 \u043C\u043D\u0435 \u043C\u0435\u0447"
      nextNodeId: 9
      action: 0
      actionParam: 
      conditionTag: mayor_sword
    - text: "\u041A\u0430\u043A \u0442\u0430\u043C \u0441\u043B\u0438\u0437\u043D\u0438?
        \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?"
      nextNodeId: 8
      action: 0
      actionParam: 
      conditionTag: mayor_clear
    - text: "\u0421\u043B\u0438\u0437\u043D\u0435\u0439 \u043F\u0440\u043E\u0433\u043D\u0430\u043B!
        \u0427\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435?"
      nextNodeId: 6
      action: 0
      actionParam: 
      conditionTag: mayor_tools
  - id: 1
    text: "\u0414\u043E\u043B\u0438\u043D\u0430 \u0417\u0430\u0440\u0438 \u2014 \u043C\u0435\u0441\u0442\u043E,
      \u0433\u0434\u0435 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B \u0438\u0434\u0443\u0442
      \u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043A\u0443. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0437\u0434\u0435\u0441\u044C \u0441\u0432\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0438 \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E: \u043A\u0442\u043E
      \u0441\u0430\u0436\u0430\u0435\u0442, \u043A\u0442\u043E \u043A\u0443\u0451\u0442,
      \u043A\u0442\u043E \u0440\u044B\u0431\u0443 \u043B\u043E\u0432\u0438\u0442.
      \u0420\u0430\u0431\u043E\u0442\u0430 \u2014 \u044D\u0442\u043E \u043B\u0435\u0447\u0435\u043D\u0438\u0435:
      \u0440\u0443\u043A\u0438 \u0437\u0430\u043D\u044F\u0442\u044B, \u0433\u043E\u043B\u043E\u0432\u0430
      \u043E\u0442\u0434\u044B\u0445\u0430\u0435\u0442, \u0430 \u0442\u0435\u043B\u043E
      \u0432 \u043A\u0430\u043F\u0441\u0443\u043B\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \u043A\u0430\u043A \u043C\u043D\u0435 \u0432\u044B\u0439\u0442\u0438
        \u043E\u0442\u0441\u044E\u0434\u0430?"
      nextNodeId: 2
      action: 0
      actionParam: 
      conditionTag: 
  - id: 2
    text: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043F\u0440\u043E\u0441\u0442:
      1 \u0437\u043E\u043B\u043E\u0442\u043E \u0437\u0434\u0435\u0441\u044C = 1 \u043A\u0440\u0435\u0434\u0438\u0442
      \u0442\u0430\u043C. \u0417\u0430\u043A\u0440\u043E\u0435\u0442\u0435 500 000
      \u2014 \u043E\u0442\u043A\u0440\u043E\u044E \u0432\u0430\u043C \u0433\u043B\u0430\u0437\u0430.
      \u0427\u0435\u0441\u0442\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435,
      \u043D\u0435 \u0434\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
      \u2014 \u0442\u0443\u0442 \u0441\u0435\u0440\u0432\u0435\u0440 \u0441\u0442\u0440\u043E\u0433\u0438\u0439.
      \u0412\u043E\u043F\u0440\u043E\u0441\u044B?"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E
        \u0441\u0435\u0439\u0447\u0430\u0441?"
      nextNodeId: 3
      action: 0
      actionParam: 
      conditionTag: 
  - id: 3
    text: "\u0423\u0447\u0430\u0441\u0442\u043E\u043A \u21169 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0442\u0432\u043E\u0439 \u2014 \u0438\u0434\u0438 \u0442\u0443\u0434\u0430.
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0437\u0431\u0435\u0440\u0438\u0441\u044C
      \u0441 \u043C\u0435\u0447\u043E\u043C \u2014 \u043E\u043D \u0443\u0436\u0435
      \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435, \u0436\u0451\u043B\u0442\u0430\u044F
      \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438
      \u043F\u0440\u043E\u0432\u0435\u0434\u0443\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0438\u0434\u0438 \u043D\u0430 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0440\u0442\u0430\u043B \u043D\u0430
      \u044E\u0433\u0435, \u0433\u043E\u043D\u0438 \u0441\u043B\u0438\u0437\u043D\u0435\u0439.
      \u0412\u0435\u0440\u043D\u0451\u0448\u044C\u0441\u044F \u2014 \u0432\u044B\u0434\u0430\u043C
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442 \u0438 \u0441\u0435\u043C\u0435\u043D\u0430.
      \u0423\u0440\u043E\u0436\u0430\u0439 \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043D\u0435\u0441\u0451\u0448\u044C
      \u0414\u0440\u043E\u043D\u0443 \u2014 \u043E\u043D \u0441\u043A\u0443\u043F\u0430\u0435\u0442."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \u043C\u0435\u0447 \u0433\u0434\u0435?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
  - id: 7
    text: "\u041E\u0447\u043D\u0443\u043B\u0441\u044F! \u041E\u0442\u043B\u0438\u0447\u043D\u043E...
      \u041F\u0443\u043B\u044C\u0441 \u0435\u0441\u0442\u044C, \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u044B
      \u0435\u0441\u0442\u044C! \u042F \u2014 \u043C\u044D\u0440 \u0410\u0432\u0440\u0435\u043B\u0438\u0439,
      \u0442\u0432\u043E\u0439 \u043A\u0443\u0440\u0430\u0442\u043E\u0440."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0427\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435?"
      nextNodeId: 12
      action: 0
      actionParam: 
      conditionTag: 
  - id: 12
    text: "\u042D\u0442\u043E \u0414\u043E\u043B\u0438\u043D\u0430 \u0417\u0430\u0440\u0438
      \u2014 \u043B\u0435\u0447\u0435\u0431\u043D\u0430\u044F \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u043A\u0430.
      \u0422\u0435\u043B\u043E \u0442\u0432\u043E\u0451 \u0441\u043F\u0438\u0442
      \u0432 \u043A\u0430\u043F\u0441\u0443\u043B\u0435, \u0430 \u0437\u0434\u0435\u0441\u044C
      \u0442\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C \u0438
      \u0432\u044B\u0437\u0434\u043E\u0440\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0448\u044C.
      \u0414\u043E\u043B\u0433 \u0437\u0430 \u043B\u0435\u0447\u0435\u043D\u0438\u0435
      \u2014 500 000. \u041E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0448\u044C
      \u2014 \u043F\u0440\u043E\u0441\u043D\u0451\u0448\u044C\u0441\u044F."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0418 \u0447\u0442\u043E \u043C\u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u0422\u0430\u043A, \u043C\u0435\u0447 \u0442\u0432\u043E\u0439. \u041E\u043D
      \u0443\u0436\u0435 \u043B\u0435\u0436\u0438\u0442 \u0443 \u0442\u0435\u0431\u044F
      \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435 \u2014 \u0441\u0430\u043C
      \u0432 \u0440\u0443\u043A\u0438 \u043D\u0435 \u043F\u0440\u044B\u0433\u043D\u0435\u0442."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0410 \u0433\u0434\u0435 \u0440\u044E\u043A\u0437\u0430\u043A?"
      nextNodeId: 11
      action: 0
      actionParam: 
      conditionTag: 
  - id: 11
    text: "\u0416\u0451\u043B\u0442\u0430\u044F \u0441\u0442\u0440\u0435\u043B\u043A\u0430
      \u043F\u043E\u043A\u0430\u0436\u0435\u0442 \u0440\u044E\u043A\u0437\u0430\u043A
      \u2014 \u043E\u0442\u043A\u0440\u043E\u0439 \u0435\u0433\u043E \u0438 \u043D\u0430\u0439\u0434\u0438
      \u043C\u0435\u0447."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041D\u0430\u0448\u0451\u043B. \u0414\u0430\u043B\u044C\u0448\u0435?"
      nextNodeId: 13
      action: 0
      actionParam: 
      conditionTag: 
  - id: 13
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0437\u0430\u0436\u043C\u0438 \u043C\u0435\u0447
      \u0438 \u0442\u0430\u0449\u0438 \u0435\u0433\u043E \u0432 \u043D\u0438\u0436\u043D\u0438\u0439
      \u0440\u044F\u0434 \u2014 \u044D\u0442\u043E \u0445\u043E\u0442\u0431\u0430\u0440.
      \u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043C\u0435\u0447 \u0442\u0430\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C \u0432 \u0440\u0443\u043A\u0438.
      \u0410 \u0443\u0436\u0435 \u043F\u043E\u0442\u043E\u043C \u2014 \u0438\u0434\u0438
      \u043D\u0430 \u0421\u0412\u041E\u0419 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u21169 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0440\u0442\u0430\u043B
      \u043D\u0430 \u044E\u0433\u0435: \u043E\u043D \u0442\u0435\u043F\u0435\u0440\u044C
      \u0442\u0432\u043E\u0439, \u0442\u0430\u043C \u0441\u043B\u0438\u0437\u043D\u0438
      \u0437\u0430\u0432\u0435\u043B\u0438\u0441\u044C \u2014 \u0433\u043E\u043D\u0438
      \u0438\u0445 \u0432\u0441\u0435\u0445. \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C
      \u2014 \u043F\u0440\u0438\u0445\u043E\u0434\u0438 \u043A\u043E \u043C\u043D\u0435,
      \u0435\u0449\u0451 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u043E\u043D\u044F\u043B, \u043F\u043E\u0433\u043D\u0430\u043B!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 8
    text: "\u0421\u043B\u0438\u0437\u043D\u0438 \u0441\u0430\u043C\u0438 \u0441\u0435\u0431\u044F
      \u043D\u0435 \u0443\u0431\u044C\u044E\u0442, \u043F\u0430\u0446\u0438\u0435\u043D\u0442!
      \u041C\u0435\u0447 \u0432 \u0440\u0443\u043A\u0438 \u2014 \u0438 \u043D\u0430
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0440\u0442\u0430\u043B
      \u043D\u0430 \u044E\u0433\u0435 \u0433\u043E\u0440\u043E\u0434\u0430. \u0413\u043E\u043D\u0438
      \u0438\u0445 \u0432\u0441\u0435\u0445, \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0445\u043E\u0434\u0438.
      \u0415\u0441\u043B\u0438 \u043C\u0435\u0447 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u2014 \u0441\u043A\u0430\u0436\u0438, \u0432\u044B\u0434\u0430\u043C... \u0445\u043E\u0442\u044F
      \u043D\u0435\u0442, \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0439.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043D\u0435 \u0434\u0430\u043C!"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u043E\u043D\u044F\u043B, \u043F\u043E\u0433\u043D\u0430\u043B!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 9
    text: "\u041C\u0435\u0447 \u0443\u0436\u0435 \u0443 \u0442\u0435\u0431\u044F
      \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435, \u043F\u0430\u0446\u0438\u0435\u043D\u0442!
      \u041E\u0442\u043A\u0440\u043E\u0439 \u0440\u044E\u043A\u0437\u0430\u043A,
      \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u043C\u0435\u0447 \u0432
      \u043D\u0438\u0436\u043D\u0438\u0439 \u0440\u044F\u0434 \u0438 \u043D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u043D\u0435\u0433\u043E. \u041F\u043E\u0442\u043E\u043C \u2014
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u21169 \u0438 \u0441\u043B\u0438\u0437\u043D\u0438.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438, \u043A\u0430\u043A \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0448\u044C."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043C\u0435\u0447"
      nextNodeId: -1
      action: 7
      actionParam: GiveSword
      conditionTag: 
  - id: 6
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u043F\u0430\u0446\u0438\u0435\u043D\u0442! \u042F \u0432\u0435\u0440\u0438\u043B
      \u2014 \u0441 \u044D\u0442\u0438\u043C \u043F\u0443\u0441\u0442\u044F\u043A\u043E\u043C
      \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.
      \u0414\u0435\u0440\u0436\u0438 \u043D\u0430\u0431\u043E\u0440 \u043D\u043E\u0432\u043E\u0441\u0451\u043B\u0430:
      \u043C\u043E\u0442\u044B\u0433\u0430, \u0441\u0435\u0440\u043F, \u043B\u0435\u0439\u043A\u0430
      \u0438 6 \u0441\u0435\u043C\u044F\u043D \u043F\u0448\u0435\u043D\u0438\u0446\u044B.
      \u041C\u043E\u0442\u044B\u0433\u0430 \u0443\u0436\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0432 \u0440\u0443\u043A\u0430\u0445! \u0421\u0430\u0436\u0430\u0439 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0434\u043E\u043C\u043E\u043C \u2014 \u0442\u0430\u043C \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u0432\u043E\u0434\u0443 \u0434\u043B\u044F
      \u043F\u043E\u043B\u0438\u0432\u0430 \u0431\u0440\u0430\u0442\u044C \u043F\u0440\u043E\u0449\u0435.
      \u0412\u0441\u043A\u043E\u043F\u0430\u0439 6 \u0433\u0440\u044F\u0434\u043E\u043A,
      \u043F\u043E\u0441\u0430\u0434\u0438, \u043F\u043E\u043B\u0435\u0439."
