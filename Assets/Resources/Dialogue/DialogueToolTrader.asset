  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: DialogueToolTrader
  m_EditorClassIdentifier: 
  npcName: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0411\u043E\u0440\u0438\u0441"
  portrait: {fileID: 0}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u041D\u0443\u0436\u0435\u043D \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442?
      \u0423 \u043C\u0435\u043D\u044F \u0432\u0441\u0451 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0435,
      \u043A\u0430\u043A \u0437\u0435\u043C\u043B\u044F! \u041A\u0438\u0440\u043A\u0438,
      \u0442\u043E\u043F\u043E\u0440\u044B, \u043C\u043E\u043B\u043E\u0442\u043A\u0438
      \u2014 \u0431\u0435\u0440\u0438, \u0434\u0435\u0432\u044F\u0442\u043A\u0430
      \u0431\u0435\u0437 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
      \u043D\u0438\u043A\u0443\u0434\u0430."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
      nextNodeId: -1
      action: 5
      actionParam: "\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
      conditionTag: 
    - text: "\u0410 \u043C\u043E\u0442\u044B\u0433\u0430 \u0434\u043B\u044F \u043D\u043E\u0432\u0438\u0447\u043A\u0430
        \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u0414\u043B\u044F \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u043A\u0430
      \u2014 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F! \u041C\u044D\u0440
      \u0443\u0436\u0435 \u0447\u0435\u0440\u043A\u043D\u0443\u043B \u043C\u043D\u0435.
      \u0414\u0435\u0440\u0436\u0438 \u0441\u043E\u0432\u0435\u0442: \u0441\u043F\u0435\u0440\u0432\u0430
      \u043A\u0430\u043C\u0435\u043D\u044C \u0432 \u0448\u0430\u0445\u0442\u0435
      \u0431\u0435\u0440\u0438, \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u0434\u044C.
      \u041A\u0438\u0440\u043A\u0430 \u0442\u0432\u043E\u044F \u043F\u043E\u043A\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043C\u0435\u043D\u044C \u0438
      \u0431\u0435\u0440\u0451\u0442. \u0410 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C
      \u043B\u0443\u0447\u0448\u0435 \u2014 \u043A \u0421\u0442\u0435\u043F\u0430\u043D\u0443,
      \u043E\u043D \u0437\u0430 \u0440\u0443\u0434\u0443 \u043F\u0440\u043E\u043A\u0430\u0447\u0430\u0435\u0442."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u043E\u043A\u0430\u0436\u0438 \u0442\u043E\u0432\u0430\u0440."
      nextNodeId: -1
      action: 5
      actionParam: "\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
      conditionTag: 
    - text: "\u041F\u043E\u043D\u044F\u043B, \u0441\u043F\u0430\u0441\u0438\u0431\u043E!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
