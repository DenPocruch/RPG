  m_Script: {fileID: 11500000, guid: a65fbd2efba55614eb3c8a768fe3d1aa, type: 3}
  m_Name: DialogueBuyer
  m_EditorClassIdentifier: 
  npcName: "\u0421\u043A\u0443\u043F\u0449\u0438\u043A \u0414\u0440\u043E\u043D"
  portrait: {fileID: 0}
  startNodeId: 0
  nodes:
  - id: 0
    text: "\u0422\u0430\u043A-\u0442\u0430\u043A-\u0442\u0430\u043A! \u041D\u043E\u0432\u0435\u043D\u044C\u043A\u0438\u0439!
      \u0421 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E? \u0423\u0440\u043E\u0436\u0430\u0439?
      \u041D\u0435\u0441\u0438 \u0441\u044E\u0434\u0430! \u0417\u0430 \u0432\u043E\u0441\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u043B\u0430\u0447\u0443 \u0432\u0434\u0432\u043E\u0435! \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443 \u043D\u0430\u0441 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0435\u0449\u0451
      \u043E\u0433\u043E-\u0433\u043E \u0431\u0443\u0434\u0435\u0442!"
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0446\u0435\u043D\u044B"
      nextNodeId: -1
      action: 6
      actionParam: 
      conditionTag: 
    - text: "\u0410 \u0442\u044B \u0441\u0430\u043C \u043A\u0442\u043E, \u0414\u0440\u043E\u043D?"
      nextNodeId: 10
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438!"
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
  - id: 10
    text: "\u042F? \u0425\u0430! \u042F \u2014 \u043B\u0443\u0447\u0448\u0438\u0439
      \u0434\u0440\u0443\u0433 \u0444\u0435\u0440\u043C\u0435\u0440\u0430! \u0411\u0435\u0440\u0443
      \u0432\u0441\u0451: \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0443, \u0442\u044B\u043A\u0432\u0443,
      \u0432\u0438\u043D\u043E, \u0441\u044B\u0440... \u0421\u043B\u0443\u0448\u0430\u0439...
      \u0442\u0435\u0431\u0435 \u0441\u0447\u0451\u0442\u0447\u0438\u043A \u043D\u0435
      \u0432\u0440\u0451\u0442? 500 \u0442\u044B\u0441\u044F\u0447, \u0430\u0433\u0430...
      \u0422\u044B \u0441\u0447\u0438\u0442\u0430\u0439, \u0441\u0447\u0438\u0442\u0430\u0439.
      \u0410 \u0437\u0430\u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043E-\u0431\u044B\u0441\u0442\u0440\u043E\u043C\u0443
      \u2014 \u0437\u0430\u0445\u043E\u0434\u0438. \u0415\u0441\u0442\u044C... \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u0427\u0442\u043E \u0437\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B?"
      nextNodeId: 11
      action: 0
      actionParam: 
      conditionTag: 
    - text: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0445\u043E\u0447\u0443."
      nextNodeId: -1
      action: 6
      actionParam: 
      conditionTag: 
  - id: 11
    text: "\u0422\u0441-\u0441! \u041D\u0435 \u0437\u0434\u0435\u0441\u044C. \u041F\u0440\u0438\u0445\u043E\u0434\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0438\u0442
      \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443. \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043F\u0440\u043E \u044F\u0434\u0440\u043E, \u043F\u0440\u043E \u0448\u0430\u0445\u0442\u0443...
      \u043F\u0440\u043E \u0442\u043E, \u043A\u0430\u043A \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B
      \u043D\u0430\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u044E\u0442. \u0410
      \u043F\u043E\u043A\u0430 \u2014 \u043D\u0435\u0441\u0438 \u0443\u0440\u043E\u0436\u0430\u0439,
      \u043D\u0435\u0441\u0438! \u042F \u0447\u0435\u0441\u0442\u043D\u043E \u043F\u043B\u0430\u0447\u0443.
      \u041F\u043E\u043A\u0430 \u0447\u0435\u0441\u0442\u043D\u043E."
    portraitOverride: {fileID: 0}
    options:
    - text: "\u041B\u0430\u0434\u043D\u043E... \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0434\u0430\u043C."
      nextNodeId: -1
      action: 6
      actionParam: 
      conditionTag: 
    - text: "\u0417\u0432\u0443\u0447\u0438\u0442 \u043C\u0443\u0442\u043D\u043E."
      nextNodeId: -1
      action: 0
      actionParam: 
      conditionTag: 
